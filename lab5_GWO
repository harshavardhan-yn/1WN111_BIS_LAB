      "source": [
        "\n",
        "import random\n",
        "\n",
        "# Job processing times\n",
        "jobs = [4, 7, 2, 5, 8]\n",
        "\n",
        "# Number of machines\n",
        "machines = 2\n",
        "\n",
        "# GWO parameters\n",
        "wolves_count = 20\n",
        "iterations = 100\n",
        "\n",
        "# Generate random wolves\n",
        "wolves = [\n",
        "    [random.random() for _ in jobs]\n",
        "    for _ in range(wolves_count)\n",
        "]\n",
        "\n",
        "# Convert wolf position into job allocation\n",
        "def allocate(wolf):\n",
        "    machine1 = []\n",
        "    machine2 = []\n",
        "\n",
        "    for i in range(len(jobs)):\n",
        "        if wolf[i] < 0.5:\n",
        "            machine1.append(i)\n",
        "        else:\n",
        "            machine2.append(i)\n",
        "\n",
        "    return machine1, machine2\n",
        "\n",
        "\n",
        "# Calculate fitness (makespan)\n",
        "def fitness(wolf):\n",
        "    m1, m2 = allocate(wolf)\n",
        "\n",
        "    time1 = sum(jobs[i] for i in m1)\n",
        "    time2 = sum(jobs[i] for i in m2)\n",
        "\n",
        "    return max(time1, time2)\n",
        "\n",
        "\n",
        "# Store best solution found\n",
        "best_wolf = None\n",
        "best_fitness = float('inf')\n",
        "\n",
        "# Grey Wolf Optimization\n",
        "for t in range(iterations):\n",
        "\n",
        "    # Sort wolves according to fitness\n",
        "    wolves.sort(key=fitness)\n",
        "\n",
        "    alpha = wolves[0][:]\n",
        "    beta = wolves[1][:]\n",
        "    delta = wolves[2][:]\n",
        "\n",
        "    # Save best solution\n",
        "    if fitness(alpha) < best_fitness:\n",
        "        best_fitness = fitness(alpha)\n",
        "        best_wolf = alpha[:]\n",
        "\n",
        "    # Decrease exploration parameter\n",
        "    a = 2 - (2 * t / iterations)\n",
        "\n",
        "    new_wolves = []\n",
        "\n",
        "    for wolf in wolves:\n",
        "        new_position = []\n",
        "\n",
        "        for j in range(len(jobs)):\n",
        "\n",
        "            positions = []\n",
        "\n",
        "            for leader in [alpha, beta, delta]:\n",
        "\n",
        "                r1 = random.random()\n",
        "                r2 = random.random()\n",
        "\n",
        "                A = 2 * a * r1 - a\n",
        "                C = 2 * r2\n",
        "\n",
        "                D = abs(C * leader[j] - wolf[j])\n",
        "\n",
        "                X = leader[j] - A * D\n",
        "\n",
        "                positions.append(X)\n",
        "\n",
        "            # Average of three leaders\n",
        "            new_value = sum(positions) / 3\n",
        "\n",
        "            # Restrict position between 0 and 1\n",
        "            new_value = max(0, min(1, new_value))\n",
        "\n",
        "            new_position.append(new_value)\n",
        "\n",
        "        new_wolves.append(new_position)\n",
        "\n",
        "    wolves = new_wolves\n",
        "\n",
        "# Check final population\n",
        "wolves.sort(key=fitness)\n",
        "\n",
        "if fitness(wolves[0]) < best_fitness:\n",
        "    best_wolf = wolves[0][:]\n",
        "    best_fitness = fitness(best_wolf)\n",
        "\n",
        "# Display result\n",
        "m1, m2 = allocate(best_wolf)\n",
        "\n",
        "print(\"JOB SCHEDULING USING GWO\")\n",
        "print(\"------------------------\")\n",
        "\n",
        "print(\"Machine 1:\")\n",
        "for i in m1:\n",
        "    print(\"Job\", i + 1, \"-\", jobs[i], \"units\")\n",
        "\n",
        "print(\"Total time:\", sum(jobs[i] for i in m1))\n",
        "\n",
        "print(\"\\nMachine 2:\")\n",
        "for i in m2:\n",
        "    print(\"Job\", i + 1, \"-\", jobs[i], \"units\")\n",
        "\n",
        "print(\"Total time:\", sum(jobs[i] for i in m2))\n",
        "\n",
        "print(\"\\nMinimum Makespan:\", best_fitness)\n"
      ]
